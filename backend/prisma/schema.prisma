// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String   @unique
  stockQuantity Int
  costPrice     Float    // Required to calculate Profit
  retailPrice   Float    // The "MRP" or market price
  salePrice     Float    // The actual price you sell at
  category      String   // "Components" or "Kits"
  subCategory   String?  // Only if Kit: "Advance", "Basic", "Component Kit"
  createdAt     DateTime @default(now())
  SaleItem      SaleItem[]
}

model Sale {
  id                String   @id @default(uuid())
  customerName      String?
  customerPhone     String?
  customerEmail     String?
  customerAddress   String?
  customerPostalCode String?
  totalAmount       Float
  totalProfit       Float    // Calculated at time of sale
  status            String   @default("COMPLETED") // "COMPLETED", "QUOTATION", "PARKED"
  createdAt         DateTime @default(now())
  items             SaleItem[]
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  price     Float   // Price at moment of sale
  serialNumber String?
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id])
}
